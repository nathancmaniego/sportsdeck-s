# Copy to .env and fill in values. Never commit .env.

# Local (host machine): Postgres from docker-compose is mapped to localhost:8008
DATABASE_URL="postgresql://postgres:password@localhost:8008/sportsdeck"

# Seeding / hosting on Supabase: use the URI from Project Settings → Database.
# Append ?sslmode=require if not already present.
# If db.*.supabase.co:5432 is unreachable from your network, use "Connection pooling"
# (Transaction mode, port 6543) and add &pgbouncer=true (e.g. ...?sslmode=require&pgbouncer=true).

JWT_SECRET="generate-a-long-random-string"

FOOTBALL_DATA_API_KEY="your-football-data-org-api-token"
HUGGINGFACE_API_KEY="your-huggingface-token"

# Google OAuth (optional). Add authorized redirect:
#   http://localhost:3000/api/auth/oauth/google/callback
# Production: https://YOUR_DOMAIN/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Production / Vercel: public site URL (no trailing slash). Required for correct OAuth redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
